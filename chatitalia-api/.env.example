# Clerk (backend) - copie para .env e preencha
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# MongoDB
MONGODB_URI=mongodb://root:example@localhost:27017
MONGODB_DB_NAME=chatitalia



# OpenRouter (LLM + STT)
OPENROUTER_API_KEY=sk-or-v1-...

# WAHA (WhatsApp) - chave da API (header X-Api-Key) e senha do dashboard/swagger
WAHA_API_KEY=troque-por-uma-chave-aleatoria
WAHA_DASHBOARD_PASSWORD=troque-por-uma-senha
# Nome da sessão no dashboard do WAHA (o número logado via QR code)
WAHA_SESSION=default
# Chave HMAC do webhook do WAHA (a mesma vai no webhook da sessão, no dashboard)
WAHA_WEBHOOK_HMAC_KEY=troque-por-uma-chave-aleatoria
