{
  "name": "chatitalia-api",
  "version": "1.0.0",
  "description": "Minimal Express server with a POST route on port 8080",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "queue:start": "ts-node src/queue/index.ts",
    "queue:dev": "ts-node-dev --respawn --transpile-only src/queue/index.ts",
    "demo": "ts-node src/demo-langgraph.ts",
    "build": "tsc -p ."
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@langchain/community": "^1.1.17",
    "@langchain/core": "^1.1.27",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.8",
    "@langchain/textsplitters": "^1.0.1",
    "@xenova/transformers": "^2.17.2",
    "bull": "^4.11.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "langchain": "^1.5.10",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.2",
    "neo4j-driver": "^5.28.0",
    "pdfjs-dist": "^4.0.379",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^4.6.11",
    "svix": "^1.99.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/mongodb": "^4.0.6",
    "@types/node": "^20.5.6",
    "@types/pino": "^7.0.4",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
